{
  "name": "ytdlpgrab",
  "version": "0.1.0",
  "description": "Drag YouTube thumbnails or titles out of Chrome and let a local helper turn them into MP4 files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danialbka/ytdlpgrab.git"
  },
  "bugs": {
    "url": "https://github.com/danialbka/ytdlpgrab/issues"
  },
  "homepage": "https://github.com/danialbka/ytdlpgrab#readme",
  "scripts": {
    "start": "node src/server/index.js",
    "check": "node --check src/server/index.js && node --check src/extension/content.js && node --check src/extension/background.js && node --check src/extension/popup.js",
    "build:mac-app": "bash src/scripts/build-mac-app.sh",
    "install:mac-app": "bash src/scripts/install-mac-app.sh",
    "package:extension": "bash src/scripts/package-extension.sh",
    "package:dmg": "bash src/scripts/build-dmg.sh",
    "package:release": "bash src/scripts/package-release.sh",
    "install:yt-dlp": "bash src/scripts/install-yt-dlp-nightly.sh",
    "install:yt-dlp:pip": "bash src/scripts/install-yt-dlp-local.sh",
    "install:launch-agent": "bash src/scripts/install-launch-agent.sh",
    "uninstall:launch-agent": "bash src/scripts/uninstall-launch-agent.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
